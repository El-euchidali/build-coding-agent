INNKUBE_API_KEY=your_api_key_here
INNKUBE_BASE_URL=https://llms.innkube.fim.uni-passau.de
INNKUBE_MODEL=gemma4-31b-it
# LLM request timeout in seconds (default 300). Increase if you see "Request timed out".
INNKUBE_TIMEOUT=600
# Optional: lighter/faster model for exploration (reads, searches) — strongly recommended
INNKUBE_MODEL_LIGHT=gemma3-12b-it